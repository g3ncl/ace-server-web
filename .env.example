# Full folder containing AssettoCorsaEVOServer.exe and content.kspkg.
ACE_SERVER_DIR="/home/claudio/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/Assetto Corsa EVO Dedicated Server"
# Local development data only; containers always use the ace-data volume.
ACE_DATA_DIR=./data
ACE_WEB_HOST=127.0.0.1
WEB_PORT=3000
# Game and EVO HTTP ports are chosen in the web UI; Save + Restart applies them.
ACE_WEB_USER=admin
ACE_WEB_PASSWORD=
ACE_AUTO_START=false
